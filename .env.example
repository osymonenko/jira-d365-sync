D365_URL=https://amcbridge.crm.dynamics.com/
USER_DATA_DIR=./browser-profile

# Set BROWSER_MODE=cdp to connect to an already-running Chrome instead of launching Chromium.
# Start Chrome with: chrome.exe --remote-debugging-port=9222
# Then navigate to D365 and make sure you're logged in before running this tool.
BROWSER_MODE=persistent
CDP_URL=http://localhost:9222

# Jira sync settings (used by jira-sync.bat)
JIRA_URL=https://amcbridge.atlassian.net
JIRA_EMAIL=your.email@amcbridge.com
JIRA_API_TOKEN=your_api_token_here
JIRA_PROJECT=GT2
# Jira accountId the activity JQL queries filter on (BY / creator / status-changed).
# Leave empty to use the API-token owner (resolved via /rest/api/3/myself).
JIRA_ACCOUNT_ID=

# Path to the timesheet workbook. Set via the GUI Settings dialog; persisted here
# so it survives restarts. Falls back to data\timesheet.xlsx if empty.
EXCEL_FILE=

# A known sprint-end Friday (YYYY-MM-DD). 2-week sprint cycles are counted from
# it in both directions. Empty = sprint-end tasks are skipped by fill-standard.
SPRINT_ANCHOR=
